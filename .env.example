# Copia este archivo a .env.local y da un valor a cada variable.
# No pongas aquí valores reales: este archivo se versiona.

# Secreto de firma de la cookie de sesión (aleatorio, 32 caracteres o más).
SESSION_SECRET=

# Contraseñas de las cuentas de la demo (ver CUENTAS en src/server/auth/cuentas.ts).
DEMO_PASSWORD_RASEK=
DEMO_PASSWORD_SERGIO=
DEMO_PASSWORD_BENJAMIN=


# Claves de las cuentas de la demo (ver CUENTAS en src/server/auth/cuentas.ts).
# Genera una clave segura con:
# openssl rand -base64 32 | tr '+/' '-_' | tr -d '='
DEMO_CLAVE_RASEK=
DEMO_CLAVE_BENJAMIN=
DEMO_CLAVE_SERGIO=